// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  firebaseId String @unique
  email     String   @unique
  name      String?
  provider  String
  photoURL String?
  public_id String?
  isVerified Boolean @default(false)

  resume Resume?
  mockInterviews MockInterview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}


model Resume{
     id Int @id @default(autoincrement())
     userId Int @unique
     title String?
     summary String?

     phone String?
     location String?
     linkedin String?
     github String?
     portfolio String?

     skills Skill[]
     experiences Experience[]
     educations Education[]
     projects Project[]
     certifications Certification[]

     user User @relation(fields:[userId],references:[id],onDelete:Cascade)

     createdAt DateTime @default(now())
     updatedAt DateTime @updatedAt
}

model Skill{
  id Int @id @default(autoincrement())
  name String
  resumeId Int

  resume Resume @relation(fields:[resumeId],references:[id],onDelete:Cascade)

}

model Experience{
  id Int @id @default(autoincrement())
  resumeId Int

  company String
  position String
  location String?
  startDate DateTime
  endDate DateTime?
  description String?

  resume Resume @relation(fields:[resumeId],references:[id],onDelete:Cascade)
}

model Education{
  id Int @id @default(autoincrement())
  resumeId Int

  institution String
  degree String
  field String?
  startDate DateTime?
  endDate DateTime?
  grade String?

  resume Resume @relation(fields:[resumeId],references:[id],onDelete:Cascade)
}

model Project{
  id Int @id @default(autoincrement())
  resumeId    Int

  name        String
  description String?
  githubUrl   String?
  liveUrl     String?
  technologies Technology[]

  resume      Resume  @relation(fields: [resumeId], references: [id],onDelete:Cascade)
}

model Technology{
   id Int @id @default(autoincrement())
   projectId Int

   name String?

   project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
}


model Certification {
  id          Int      @id @default(autoincrement())
  resumeId    Int

  name        String
  issuer      String?
  issueDate   DateTime?
  credentialUrl String?

  resume      Resume   @relation(fields: [resumeId], references: [id],onDelete:Cascade)
}

enum InterviewStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MockInterview{
    id Int @id @default(autoincrement())
    userId Int 

    role String
    round   String
    experience      String
    duration        Int

    status     InterviewStatus     @default(CREATED)

    startedAt       DateTime?
    completedAt     DateTime?

    score           Float?
    feedback        String?

    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    user            User     @relation(fields: [userId], references: [id],onDelete:Cascade)

    questions       MockQuestion[]


}


model MockQuestion{
  id Int @id @default(autoincrement())
  interviewId Int 

  question       String
  answer          String?

  feedback        String?
  score           Float?

  order           Int

  createdAt       DateTime @default(now())

  interview       MockInterview @relation(fields: [interviewId], references: [id],onDelete: Cascade)
}